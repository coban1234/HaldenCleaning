# Resend (https://resend.com) — required to send booking confirmations.
RESEND_API_KEY=re_xxxxxxxx
# Must be a verified domain in Resend. For tests: Threshold <beth.t@example.com>
BOOKING_FROM=Threshold Cleaning <hello@thresholdcleaning.ca>
# Copy of every residential booking (defaults to hello@thresholdcleaning.ca)
BOOKING_OPS_EMAIL=hello@thresholdcleaning.ca
