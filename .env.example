# Resend (https://resend.com) — required to send booking confirmations.
RESEND_API_KEY=re_xxxxxxxx
# Must be a verified domain in Resend. For tests: HalderCleaning <beth.t@example.com>
BOOKING_FROM=HalderCleaning <hello@haldercleaning.ca>
# Copy of every residential booking (defaults to hello@haldercleaning.ca)
BOOKING_OPS_EMAIL=hello@haldercleaning.ca
