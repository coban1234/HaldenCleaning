---
import { brand } from "../data/brand";
import { residentialServices, commercialServices, strataServices } from "../data/services";
import { areas } from "../data/areas";
---

<footer class="bg-euc-dk text-chalk">
  <div class="mx-auto max-w-page px-5 md:px-8 py-12 grid sm:grid-cols-2 lg:grid-cols-5 gap-8 text-[15px]">
    <div>
      <p class="display text-[18px] font-semibold">{brand.name}</p>
      <p class="mt-2 text-euc-lt">{brand.region}</p>
      <p class="mt-3">
        <a class="text-chalk hover:underline" href={brand.phoneHref}>{brand.phone}</a>
      </p>
      <p>
        <a class="text-euc-lt hover:underline" href={`mailto:${brand.email}`}>{brand.email}</a>
      </p>
    </div>
    <div>
      <p class="font-semibold">Home cleaning</p>
      <ul class="mt-2 space-y-1.5 text-euc-lt">
        {
          residentialServices.map((s) => (
            <li>
              <a href={`/home-cleaning/${s.slug}/`}>{s.eyebrow.split("·")[1]?.trim() ?? s.slug}</a>
            </li>
          ))
        }
        <li><a href="/home-cleaning/whats-included/">What's included</a></li>
      </ul>
    </div>
    <div>
      <p class="font-semibold">Commercial</p>
      <ul class="mt-2 space-y-1.5 text-euc-lt">
        {
          commercialServices.map((s) => (
            <li>
              <a href={`/commercial/${s.slug}/`}>{s.eyebrow.split("·")[1]?.trim() ?? s.slug}</a>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <p class="font-semibold">Strata</p>
      <ul class="mt-2 space-y-1.5 text-euc-lt">
        {
          strataServices.map((s) => (
            <li>
              <a href={`/strata/${s.slug}/`}>{s.eyebrow.split("·")[1]?.trim() ?? s.slug}</a>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <p class="font-semibold">Company</p>
      <ul class="mt-2 space-y-1.5 text-euc-lt">
        <li><a href="/our-team/">Our team</a></li>
        <li><a href="/areas/">Areas</a></li>
        {
          areas.slice(0, 3).map((a) => (
            <li>
              <a href={`/areas/${a.slug}/`}>{a.name}</a>
            </li>
          ))
        }
        <li><a href="/reviews/">Reviews</a></li>
        <li><a href="/about/">About</a></li>
        <li><a href="/contact/">Contact</a></li>
      </ul>
    </div>
  </div>
  <div
    class="border-t border-euc mx-auto max-w-page px-5 md:px-8 py-5 text-[13px] text-euc-lt flex flex-wrap gap-x-6 gap-y-2"
  >
    <span>{brand.address}</span>
    <span>{brand.hours}</span>
    <span>WCB covered</span>
    <span>Insured and bonded</span>
    <span>© {brand.year} {brand.legalName}</span>
    <a href="/privacy/">Privacy</a>
    <a href="/terms/">Terms</a>
  </div>
</footer>
