---
import { rooms } from "../data/rooms";
import { quotePrice } from "../data/pricing";

const kitchen = rooms[0];
const studio = quotePrice(1, 1, "standard", "onetime");
const twoTwo = quotePrice(2, 2, "standard", "biweekly");
const threeTwo = quotePrice(3, 2, "standard", "onetime");

const prices = [
  {
    label: "Studio / 1 bed",
    price: studio.price,
    meta: "Standard · 1 bath",
    href: "/book/?beds=1&baths=1&service=standard&freq=onetime",
    featured: false,
  },
  {
    label: "2 bed, 2 bath",
    price: twoTwo.price,
    meta: "Standard · bi-weekly",
    href: "/book/?beds=2&baths=2&service=standard&freq=biweekly",
    featured: true,
  },
  {
    label: "3 bed, 2 bath",
    price: threeTwo.price,
    meta: "Standard",
    href: "/book/?beds=3&baths=2&service=standard&freq=onetime",
    featured: false,
  },
];
---

<section class="border-y border-line bg-paper">
  <div class="mx-auto max-w-page px-5 md:px-8 py-8 md:py-10">
    <div class="grid lg:grid-cols-2 gap-10 lg:gap-12">
      <div class="min-w-0">
        <div class="flex items-baseline justify-between gap-3 mb-3">
          <h2 class="font-semibold fs-h3">{kitchen.name}</h2>
          <p class="tabular text-[11px] font-semibold tracking-[0.06em] uppercase text-euc shrink-0">
            {kitchen.included.standard.length + kitchen.addons.standard.length} checks
          </p>
        </div>
        <p class="text-[13px] text-slate mb-3">Standard visit · approx. {kitchen.minutes} min</p>
        <ul class="divide-y divide-line border-y border-line lg:border-0 lg:divide-y-0 lg:flex lg:gap-3 lg:overflow-x-auto lg:-mx-1 lg:px-1 lg:pb-1">
          {
            kitchen.included.standard.map((item) => (
              <li class="check-item flex items-center gap-2 py-2.5 text-[14px] lg:shrink-0 lg:py-2 lg:px-3 lg:bg-euc-tint lg:rounded-card lg:text-[13px]">
                <span class="text-euc" aria-hidden="true">
                  ✓
                </span>
                {item.label}
              </li>
            ))
          }
        </ul>
        <p class="mt-4 text-[11px] font-semibold tracking-[0.08em] uppercase text-slate">
          Not included — available as add-ons
        </p>
        <ul class="mt-1 divide-y divide-line lg:divide-y-0 lg:flex lg:flex-wrap lg:gap-x-4 lg:gap-y-1">
          {
            kitchen.addons.standard.map((item) => (
              <li class="check-item flex items-center justify-between gap-3 py-2.5 text-[14px] lg:justify-start lg:py-0 lg:text-[13px]">
                <span class="flex gap-2">
                  <span class="text-slate" aria-hidden="true">
                    ○
                  </span>
                  {item.label}
                </span>
                <span class="tabular text-slate">+${item.addon}</span>
              </li>
            ))
          }
        </ul>
        <p class="mt-4 text-[13px]">
          <a href="/home-cleaning/whats-included/" class="text-euc font-medium underline underline-offset-4"
            >Every room, every check →</a
          >
        </p>
      </div>

      <div class="min-w-0">
        <h2 class="display font-semibold mb-4 fs-h3">Published pricing</h2>
        <div class="flex flex-col gap-3 lg:grid lg:grid-cols-3">
          {
            prices.map((row) => (
              <article
                class:list={[
                  "flex items-center gap-4 rounded-card p-4 lg:flex-col lg:text-center lg:p-3",
                  row.featured ? "border-2 border-euc bg-euc-tint/40" : "border border-line",
                ]}
              >
                <div class="flex-1 min-w-0 lg:contents">
                  <p class="text-[11px] font-semibold tracking-[0.06em] uppercase text-euc">{row.label}</p>
                  <p class="display mt-0.5 font-semibold tabular text-ink text-[1.75rem] leading-none lg:mt-1 lg:text-xl">
                    ${row.price}
                  </p>
                  <p class="text-[12px] text-slate mt-1 lg:text-[11px]">{row.meta}</p>
                </div>
                <a
                  href={row.href}
                  class="shrink-0 inline-flex items-center justify-center min-h-12 px-5 rounded-full bg-brass text-chalk text-[13px] font-semibold hover:bg-brass-h lg:mt-3 lg:w-full lg:min-h-[48px] lg:text-[12px] lg:px-3"
                  >Book this</a
                >
              </article>
            ))
          }
        </div>
        <p class="mt-3 text-[13px]">
          <a href="/pricing/" class="text-euc font-medium underline underline-offset-4"
            >All three segments, published →</a
          >
        </p>
      </div>
    </div>
  </div>
</section>
