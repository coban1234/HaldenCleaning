---
import { brand } from "../data/brand";
import { href } from "../lib/href";

type Props = { class?: string };
const className = Astro.props.class ?? "flex items-center gap-2.5 shrink-0";
---

<a href={href("/")} class={className} aria-label={brand.name}>
  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path
      d="M5 21V5.5A1.5 1.5 0 0 1 6.5 4h11A1.5 1.5 0 0 1 19 5.5V21"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"></path>
    <path
      d="M9 21V11h6v10"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
  <span class="display text-[16px] xs:text-[18px] font-semibold tracking-tight truncate max-w-[42vw] lg:max-w-none">
    {brand.name}
  </span>
</a>
