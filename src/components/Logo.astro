---
import { brand } from "../data/brand";
import { href } from "../lib/href";

type Props = { class?: string };
const className = Astro.props.class ?? "flex items-center gap-2.5 shrink-0";
---

<a href={href("/")} class={className} aria-label={brand.name}>
  <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true" class="shrink-0">
    <rect x="3.5" y="3.5" width="21" height="21" rx="5" stroke="currentColor" stroke-width="1.5"></rect>
    <path
      d="M10 8.5v11M18 8.5v11M10 14h8"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linecap="round"></path>
  </svg>
  <span class="display text-[16px] xs:text-[18px] font-semibold tracking-tight truncate max-w-[48vw] lg:max-w-none">
    Halden<span class="font-medium">Cleaning</span>
  </span>
</a>
