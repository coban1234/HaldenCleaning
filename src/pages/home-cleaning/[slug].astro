---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { findService, residentialServices } from "../../data/services";
import { serviceLd } from "../../data/schema";
import { href } from "../../lib/href";

export function getStaticPaths() {
  return residentialServices.map((s) => ({ params: { slug: s.slug } }));
}

const { slug } = Astro.params;
const service = findService(residentialServices, slug!);
if (!service) throw new Error("Missing service");
---

<BaseLayout
  title={service.title}
  description={service.meta}
  canonical={`/home-cleaning/${service.slug}/`}
  jsonLd={serviceLd(service.h1, `/home-cleaning/${service.slug}/`, service.meta)}
>
  <article class="mx-auto max-w-page px-5 md:px-8 py-8">
    <Breadcrumbs
      items={[
        { href: "/", label: "Home" },
        { href: "/home-cleaning/", label: "Home cleaning" },
        { label: service.eyebrow.split("·")[1]?.trim() ?? service.slug },
      ]}
    />
    <p class="mt-6 text-[11px] font-semibold tracking-[0.08em] uppercase text-euc">{service.eyebrow}</p>
    <h1 class="display mt-3 font-semibold fs-hero max-w-[20ch]">{service.h1}</h1>
    <p class="mt-3 max-w-[48ch] text-slate fs-lead">{service.lead}</p>
    <a
      href={href("/book/")}
      class="mt-8 inline-flex items-center justify-center min-h-[56px] px-10 rounded-full bg-brass text-chalk font-semibold hover:bg-brass-h"
      >Book online</a
    >
    <div class="mt-10 overflow-hidden rounded-photo">
      <img src={service.image} alt="" class="w-full aspect-[16/9] object-cover" />
    </div>
    <div class="mt-12 grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        service.points.map((p, i) => (
          <div>
            <p class="text-[11px] font-semibold tracking-[0.08em] uppercase text-euc">
              {String(i + 1).padStart(2, "0")}
            </p>
            <h2 class="mt-2 font-semibold fs-h3">{p.title}</h2>
            <p class="mt-2 text-slate">{p.body}</p>
          </div>
        ))
      }
    </div>
    <p class="mt-12">
      <a href={href("/home-cleaning/whats-included/")} class="text-euc underline underline-offset-4"
        >See the room-by-room list →</a
      >
    </p>
  </article>
</BaseLayout>
