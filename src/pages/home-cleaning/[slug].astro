---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import FaqList from "../../components/FaqList.astro";
import { findService, residentialServices } from "../../data/services";
import { areas } from "../../data/areas";
import { oneTimeRates, rateRows } from "../../data/pricing";
import { serviceLd } from "../../data/schema";
import { href } from "../../lib/href";

export function getStaticPaths() {
  return residentialServices.map((s) => ({ params: { slug: s.slug } }));
}

const { slug } = Astro.params;
const service = findService(residentialServices, slug!);
if (!service) throw new Error("Missing service");

const bookHref = service.bookQuery ? `/book/?${service.bookQuery}` : "/book/";
const imageAlt = service.imageAlt || `${service.listingTitle ?? service.h1} in Vancouver.`;
const related = [
  { href: "/home-cleaning/", label: "House cleaning services in Vancouver" },
  { href: "/home-cleaning/deep-clean/", label: "Deep house cleaning" },
  { href: "/home-cleaning/move-in-move-out/", label: "Move-in and move-out cleaning" },
  { href: "/home-cleaning/whats-included/", label: "What is included, room by room" },
  { href: "/pricing/", label: "House cleaning prices" },
  { href: bookHref, label: "Book online" },
].filter((item) => !item.href.includes(`/home-cleaning/${service.slug}/`));
---

<BaseLayout
  title={service.title}
  description={service.meta}
  canonical={`/home-cleaning/${service.slug}/`}
  jsonLd={serviceLd(service.h1, `/home-cleaning/${service.slug}/`, service.meta)}
>
  <article class="mx-auto max-w-page px-5 md:px-8 py-8">
    <Breadcrumbs
      items={[
        { href: "/", label: "Home" },
        { href: "/home-cleaning/", label: "Home cleaning" },
        { label: service.eyebrow.split("·")[1]?.trim() ?? service.slug },
      ]}
    />
    <p class="mt-6 text-[11px] font-semibold tracking-[0.08em] uppercase text-euc">{service.eyebrow}</p>
    <h1 class="display mt-3 font-semibold fs-hero max-w-[22ch] md:max-w-none">{service.h1}</h1>
    <p class="mt-3 max-w-[54ch] text-slate fs-lead">{service.lead}</p>
    <div class="mt-8 flex flex-col sm:flex-row flex-wrap gap-3">
      <a
        href={href(bookHref)}
        class="inline-flex items-center justify-center min-h-[56px] px-10 rounded-full bg-brass text-chalk font-semibold hover:bg-brass-h"
        >Book this cleaning</a
      >
      <a
        href={href("/pricing/")}
        class="inline-flex items-center justify-center min-h-[56px] px-10 rounded-full border-[1.5px] border-ink font-semibold"
        >House cleaning prices</a
      >
    </div>
    <div class="mt-10 overflow-hidden rounded-photo">
      <img
        src={service.image}
        alt={imageAlt}
        class="w-full aspect-[16/9] object-cover"
        width="1200"
        height="675"
        decoding="async"
      />
    </div>
    <div class="mt-12 grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        service.points.map((p, i) => (
          <div>
            <p class="text-[11px] font-semibold tracking-[0.08em] uppercase text-euc">
              {String(i + 1).padStart(2, "0")}
            </p>
            <h2 class="mt-2 font-semibold fs-h3">{p.title}</h2>
            <p class="mt-2 text-slate">{p.body}</p>
          </div>
        ))
      }
    </div>
  </article>

  {
    service.sections?.map((section) => (
      <section class="mx-auto max-w-page px-5 md:px-8 pb-12">
        <h2 class="display font-semibold fs-h2">{section.heading}</h2>
        {section.paragraphs.map((paragraph) => (
          <p class="mt-3 max-w-[66ch] text-slate">{paragraph}</p>
        ))}
      </section>
    ))
  }

  {
    service.showMoveOutRates && (
      <section class="mx-auto max-w-page px-5 md:px-8 pb-12">
        <h2 class="display font-semibold fs-h2">Move-out cleaning prices</h2>
        <p class="mt-3 max-w-[66ch] text-slate">
          One-time flat rates for a vacant home. The quoted number is the number you pay. Five-bed and
          unusual homes are confirmed after a walkthrough. See the full table — including standard and
          deep — on
          <a href={href("/pricing/")} class="text-euc font-medium underline underline-offset-4">house cleaning prices</a>.
        </p>
        <ul class="mt-6 grid md:grid-cols-2 gap-2 tabular">
          {rateRows.map((row) => (
            <li class="flex justify-between border-b border-line py-3">
              <span>{row.label}</span>
              <span class="font-semibold">${oneTimeRates[row.key]["move-out"]}</span>
            </li>
          ))}
          <li class="flex justify-between border-b border-line py-3">
            <span>5 bed+</span>
            <span>Walkthrough</span>
          </li>
        </ul>
        <p class="mt-6">
          <a
            href={href(bookHref)}
            class="inline-flex items-center justify-center min-h-[56px] px-10 rounded-full bg-brass text-chalk font-semibold hover:bg-brass-h"
          >
            Book move-out cleaning
          </a>
        </p>
      </section>
    )
  }

  {
    service.slug === "move-in-move-out" && (
      <section class="mx-auto max-w-page px-5 md:px-8 pb-12">
        <h2 class="display font-semibold fs-h2">Areas we serve</h2>
        <p class="mt-3 max-w-[66ch] text-slate">
          Move-in and move-out cleaning across Vancouver and the Fraser Valley. These are the same
          municipalities already on this site — not extra city pages.
        </p>
        <ul class="mt-6 divide-y divide-line border-y border-line max-w-xl">
          {areas.map((area) => (
            <li>
              <a
                href={href(`/areas/${area.slug}/`)}
                class="flex min-h-[44px] items-center justify-between gap-3 py-2 font-medium hover:text-euc"
              >
                House cleaning in {area.name}
                <span class="text-slate" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    service.faqs && service.faqs.length > 0 && (
      <section class="mx-auto max-w-page px-5 md:px-8 pb-12">
        <h2 class="display font-semibold fs-h2 mb-6">FAQs</h2>
        <FaqList items={service.faqs} />
      </section>
    )
  }

  <nav class="mx-auto max-w-page px-5 md:px-8 pb-16" aria-label="Related house cleaning">
    <p class="text-[13px] font-semibold tracking-[0.06em] uppercase text-slate">Related</p>
    <ul class="mt-3 flex flex-col gap-2">
      {
        related.map((item) => (
          <li>
            <a href={href(item.href)} class="text-euc font-medium underline underline-offset-4">
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</BaseLayout>
