---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { brand } from "../data/brand";
---

<BaseLayout title={`Privacy | ${brand.name}`} description="Privacy policy." canonical="/privacy/">
  <article class="mx-auto max-w-page px-5 md:px-8 py-8 max-w-[720px]">
    <Breadcrumbs items={[{ href: "/", label: "Home" }, { label: "Privacy" }]} />
    <h1 class="display mt-6 font-semibold fs-hero">Privacy</h1>
    <p class="mt-6 text-slate">
      Booking details, access instructions and pet notes are used to deliver the service and to send
      the confirmation email. We do not sell personal information. Call recordings, if used for
      tracking, are retained only as long as needed to attribute a booking. To request deletion of a
      customer record, email {brand.email}.
    </p>
  </article>
</BaseLayout>
