---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { brand } from "../../data/brand";
import { areas } from "../../data/areas";
---

<BaseLayout
  title={`House Cleaning Areas | Vancouver & Fraser Valley | ${brand.name}`}
  description="Flat-rate house cleaning in Vancouver, Burnaby, Richmond, North Vancouver, Surrey and Coquitlam."
  canonical="/areas/"
>
  <article class="mx-auto max-w-page px-5 md:px-8 py-8">
    <Breadcrumbs items={[{ href: "/", label: "Home" }, { label: "Areas" }]} />
    <h1 class="display mt-6 font-semibold fs-hero">Vancouver and the Fraser Valley</h1>
    <p class="mt-3 max-w-[50ch] text-slate fs-lead">
      Six launch areas. Each page has local building stock, access realities, and the team who cover it.
    </p>
    <div class="mt-10 grid md:grid-cols-2 gap-5">
      {
        areas.map((area) => (
          <a href={`/areas/${area.slug}/`} class="bg-paper border border-line rounded-card overflow-hidden hover:border-euc">
            <img src={area.photo} alt={`Work in ${area.name}.`} class="w-full aspect-[16/9] object-cover" />
            <div class="p-5">
              <h2 class="font-semibold fs-h3">{area.name}</h2>
              <p class="mt-2 text-slate">{area.intro}</p>
            </div>
          </a>
        ))
      }
    </div>
  </article>
</BaseLayout>
