---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import BookingFlow from "../components/BookingFlow";
import QuoteTable from "../components/QuoteTable.astro";
import { brand } from "../data/brand";
import type { BathroomOption, BedroomOption, Frequency, ServiceLevel } from "../data/pricing";

const params = Astro.url.searchParams;
const initialBeds = (Number(params.get("beds") || 2) as BedroomOption);
const initialBaths = (Number(params.get("baths") || 2) as BathroomOption);
const initialService = (params.get("service") || "standard") as ServiceLevel;
const initialFreq = (params.get("freq") || "biweekly") as Frequency;
const initialAddOns = (params.get("addons") || "").split(",").filter(Boolean);
---

<BaseLayout
  title={`Book House Cleaning Vancouver | ${brand.name}`}
  description="Book a flat-rate house cleaning in Vancouver. Four steps, no account, price visible the whole way. Confirmation within 60 seconds."
  canonical="/book/"
  sticky={false}
>
  <article class="mx-auto max-w-page px-5 md:px-8 py-8">
    <Breadcrumbs items={[{ href: "/", label: "Home" }, { label: "Book" }]} />
    <h1 class="display mt-6 font-semibold fs-hero">Book online</h1>
    <p class="mt-3 max-w-[46ch] text-slate fs-lead">
      Four steps. No account. The price is visible and fixed at every step. A confirmation with the
      room-by-room scope goes to your email. Payment is taken at the visit.
    </p>
    <div class="mt-10">
      <BookingFlow
        client:load
        initialBeds={initialBeds}
        initialBaths={initialBaths}
        initialService={initialService}
        initialFreq={initialFreq}
        initialAddOns={initialAddOns}
      />
    </div>
    <noscript>
      <form class="mt-10 bg-paper border border-line rounded-card p-6 space-y-4" method="post" action={`mailto:${brand.email}`}>
        <h2 class="font-semibold fs-h3">Request a booking</h2>
        <label class="block">Name<input class="mt-1 w-full min-h-12 border border-line rounded-card px-3" name="name" required /></label>
        <label class="block">Address<input class="mt-1 w-full min-h-12 border border-line rounded-card px-3" name="address" required /></label>
        <label class="block">Contact<input class="mt-1 w-full min-h-12 border border-line rounded-card px-3" name="contact" required /></label>
        <label class="block">Bedrooms<input class="mt-1 w-full min-h-12 border border-line rounded-card px-3" name="beds" /></label>
        <label class="block">Bathrooms<input class="mt-1 w-full min-h-12 border border-line rounded-card px-3" name="baths" /></label>
        <label class="block">Access instructions<textarea class="mt-1 w-full min-h-24 border border-line rounded-card px-3" name="access"></textarea></label>
        <label class="block">Pets<input class="mt-1 w-full min-h-12 border border-line rounded-card px-3" name="pets" /></label>
        <button class="min-h-[56px] px-8 rounded-full bg-brass text-chalk font-semibold" type="submit">Send request</button>
      </form>
    </noscript>
    <div class="mt-16">
      <h2 class="display font-semibold fs-h2 mb-4">The rate table this booking uses</h2>
      <QuoteTable />
    </div>
  </article>
</BaseLayout>
