---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { brand, images } from "../data/brand";
import { quotePrice } from "../data/pricing";

const twoTwo = quotePrice(2, 2, "standard", "biweekly");

const principles = [
  {
    n: "01",
    title: "Every room, shown.",
    body: "Not a services list. A room-by-room breakdown — 53 checks on a standard visit, 82 on deep, 96 on move-out — visible before you book.",
  },
  {
    n: "02",
    title: "Flat rate.",
    body: "The quoted price is the price. If the home takes longer, that is our problem, not your invoice. No hourly surprises after we arrive.",
  },
  {
    n: "03",
    title: "The same people.",
    body: "Scheduled by area — not a rotating roster of strangers. That is the largest residential complaint in this category.",
  },
  {
    n: "04",
    title: "Documented for buildings.",
    body: "Digital inspection reports, a green cleaning plan, SDS sheets. Audit-ready from the first contract, not after the first complaint.",
  },
];

const facts = [
  { label: "Where", value: "Six municipalities across Vancouver and the Fraser Valley." },
  { label: "Who", value: "Crews covering Vancouver and the Fraser Valley. Criminal record check, bonded, WCB covered." },
  { label: "The number", value: `2 bed, 2 bath · bi-weekly from $${twoTwo.price}. Same table in every area.` },
];
---

<BaseLayout
  title={`About ${brand.name} | Vancouver Cleaning`}
  description="You see the whole scope before you book, and the price does not move. The same people, every visit, across Vancouver and the Fraser Valley."
  canonical="/about/"
>
  <article class="mx-auto max-w-page px-5 md:px-8 py-8">
    <Breadcrumbs items={[{ href: "/", label: "Home" }, { label: "About" }]} />
    <div class="mt-6 grid gap-8 md:grid-cols-2 md:gap-12 md:items-start">
      <div>
        <p class="text-[11px] font-semibold tracking-[0.08em] uppercase text-euc">{brand.name}</p>
        <h1 class="display mt-3 font-semibold fs-hero max-w-[14ch] md:max-w-none">
          The whole scope, before you book.
        </h1>
      </div>
      <div class="md:pt-8">
        <p class="text-ink fs-lead">
          You see the whole scope before you book, and the price does not move. The same people, every
          visit, across {brand.region}.
        </p>
        <p class="mt-4 tabular text-slate text-[15px]">
          2 bed, 2 bath · bi-weekly from
          <span class="font-semibold text-ink">${twoTwo.price}</span>
        </p>
        <div class="mt-6 flex flex-col sm:flex-row flex-wrap gap-3">
          <a
            href="/#quote"
            class="inline-flex items-center justify-center min-h-[56px] w-full sm:w-auto px-10 rounded-full bg-brass text-chalk text-[15px] font-semibold hover:bg-brass-h"
          >
            Get my price
          </a>
          <a
            href="/home-cleaning/whats-included/"
            class="inline-flex items-center justify-center min-h-[56px] w-full sm:w-auto px-8 rounded-full border-[1.5px] border-ink font-semibold"
          >
            See what's included
          </a>
        </div>
      </div>
    </div>
    <div class="mt-8 overflow-hidden rounded-photo">
      <img
        src={images.kitchenHero}
        alt="A lived-in Vancouver kitchen in natural daylight, after a standard clean."
        class="w-full aspect-[4/5] md:aspect-[16/9] object-cover"
      />
    </div>
  </article>

  <section class="mx-auto max-w-page px-5 md:px-8 pb-12 md:pb-16">
    <div class="grid gap-3 md:grid-cols-3 md:gap-0 md:items-stretch mb-8">
      <h2 class="display font-semibold fs-h2">What we will not hide</h2>
      <p class="text-slate md:col-span-2 md:flex md:items-center md:border-l md:border-line md:pl-8">
        Four claims. Each one is how the work is run, not a slogan.
      </p>
    </div>
    <ol class="bg-paper border border-line rounded-card overflow-hidden grid md:grid-cols-2">
      {
        principles.map((item, i) => (
          <li
            class:list={[
              "p-6 md:p-8",
              i < principles.length - 1 && "border-b border-line",
              i >= principles.length - 2 && "md:border-b-0",
              i % 2 === 0 && "md:border-r md:border-line",
            ]}
          >
            <p class="display tabular font-semibold text-euc leading-none text-[2.25rem] md:text-[2.75rem]">
              {item.n}
            </p>
            <h3 class="mt-5 font-semibold fs-h3">{item.title}</h3>
            <p class="mt-2 text-slate">{item.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="border-y border-line bg-paper">
    <div class="mx-auto max-w-page px-5 md:px-8 py-12 md:py-16">
      <div class="grid gap-3 md:grid-cols-3 md:gap-0 md:items-stretch mb-8">
        <h2 class="display font-semibold fs-h2">How the company is built</h2>
        <p class="text-slate md:col-span-2 md:flex md:items-center md:border-l md:border-line md:pl-8">
          Facts you can check. Not a founding myth.
        </p>
      </div>
      <div class="border border-line rounded-card overflow-hidden divide-y divide-line">
        {
          facts.map((fact) => (
            <div class="grid gap-3 md:grid-cols-3 md:gap-8 p-6 md:p-8 md:items-start">
              <h3 class="display font-semibold fs-h3">{fact.label}</h3>
              <p class="md:col-span-2 text-slate">{fact.value}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
