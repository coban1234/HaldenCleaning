---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ScopeBuilder from "../../components/ScopeBuilder";
import InspectionReport from "../../components/InspectionReport.astro";
import FaqList from "../../components/FaqList.astro";
import { brand, images } from "../../data/brand";
import { strataServices } from "../../data/services";
import { faqs } from "../../data/reviews";
import { serviceLd } from "../../data/schema";
import { href } from "../../lib/href";
---

<BaseLayout
  title={`Strata Cleaning Services Vancouver | ${brand.name}`}
  description="Strata cleaning services in Vancouver and the Fraser Valley. Cleaning solutions for shared residential spaces, strata properties, and building common areas."
  canonical="/strata/"
  cta="walkthrough"
  jsonLd={serviceLd("Strata cleaning", "/strata/", "Strata common-area programmes with AGM-ready reporting.")}
>
  <article class="mx-auto max-w-page px-5 md:px-8 py-8">
    <Breadcrumbs items={[{ href: "/", label: "Home" }, { label: "Strata" }]} />
    <p class="mt-6 text-[11px] font-semibold tracking-[0.08em] uppercase text-euc">Strata</p>
    <h1 class="display mt-3 font-semibold fs-hero max-w-[20ch]">Strata cleaning services in Vancouver</h1>
    <p class="mt-3 max-w-[52ch] text-slate fs-lead">
      Clean common areas help a building feel looked after. HaldenCleaning provides strata cleaning
      across Vancouver and the Fraser Valley for lobbies, corridors, amenities, and related building
      work such as dryer vents. Every visit is logged, photographed, and scored so property managers
      and councils have a document for the AGM — not an opinion. Buildings are quoted after a
      walkthrough, not through the house-cleaning form.
    </p>
    <a
      href={href("/contact/")}
      class="mt-6 inline-flex items-center justify-center min-h-[56px] w-full sm:w-auto px-10 rounded-full bg-brass text-chalk text-[15px] font-semibold hover:bg-brass-h"
    >
      Request a strata cleaning quote
    </a>
    <div class="mt-8 overflow-hidden rounded-photo">
      <img src={images.strata} alt="Metro Vancouver residential tower common-area exterior for strata cleaning." class="w-full aspect-[4/5] md:aspect-[16/9] object-cover" width="1200" height="800" decoding="async" />
    </div>
  </article>

  <section class="mx-auto max-w-page px-5 md:px-8 pb-16" id="scope">
    <h2 class="display font-semibold fs-h2 mb-6">Amenity checklist</h2>
    <ScopeBuilder client:load />
  </section>

  <section class="mx-auto max-w-page px-5 md:px-8 pb-16 grid md:grid-cols-2 gap-4">
    {
      strataServices.map((s) => (
        <a href={href(`/strata/${s.slug}/`)} class="bg-paper border border-line rounded-card p-5 hover:border-euc">
          <p class="text-[11px] font-semibold tracking-[0.08em] uppercase text-euc">{s.eyebrow}</p>
          <h2 class="mt-2 font-semibold fs-h3">{s.h1}</h2>
          <p class="mt-2 text-slate">{s.lead}</p>
        </a>
      ))
    }
  </section>

  <section class="mx-auto max-w-page px-5 md:px-8 pb-16">
    <h2 class="display font-semibold fs-h2 mb-6">AGM-ready reporting</h2>
    <InspectionReport />
  </section>

  <section class="mx-auto max-w-page px-5 md:px-8 pb-16">
    <h2 class="display font-semibold fs-h2 mb-6">FAQs</h2>
    <FaqList items={[...faqs.strata]} />
  </section>
</BaseLayout>
